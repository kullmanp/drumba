{
  "name": "drumba",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "check": "tsc --noEmit && vitest run && prettier --check . && npm run --silent lint:ascii",
    "prepare": "git config core.hooksPath .githooks",
    "lint:ascii": "! git grep --untracked -n -I -P '[\\x{C4}\\x{D6}\\x{DC}\\x{E4}\\x{F6}\\x{FC}\\x{DF}]' -- . ':(exclude)*.md'"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
